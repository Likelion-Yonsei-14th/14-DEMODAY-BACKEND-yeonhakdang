# Shell/IDE must load values explicitly; Spring does not auto-read .env files.
# Render supplies PORT automatically; localhost defaults to 8080.
DB_URL=jdbc:postgresql://localhost:5432/yeonhakdang
DB_USER=yeonhakdang
DB_PASSWORD=
# Single destination for Kakao login and payment return redirects.
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated exact origins (scheme + host + port, no paths).
CORS_ALLOWED_ORIGINS=https://yeonhakdang.vercel.app,http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
POLICY_VERSION=2026-10-29-draft
# Keep disabled until a reviewed paid-content producer is ready.
SALES_ENABLED=false
# Enable the kakao Spring profile only after all values below are set.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
# Test store and TEST channels only. Never put secrets in frontend env variables.
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_STORE_ID=
PORTONE_CARD_CHANNEL=
PORTONE_KAKAO_CHANNEL=
PORTONE_TOSS_CHANNEL=
